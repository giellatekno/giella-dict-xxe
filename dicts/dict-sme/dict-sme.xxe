<?xml version="1.0" encoding="UTF-8"?>
<!--
  XMLmind XML Editor (XXE) configuration for dict-sme.
  Made by make_config.py from dict-sme.toml: change that file and run make_config.py, do not edit this one.
-->
<configuration name="dict-sme" xmlns="http://www.xmlmind.com/xmleditor/schema/configuration"
    xmlns:cfg="http://www.xmlmind.com/xmleditor/schema/configuration">
    <!-- active for the files with the root element <r id="dict-sme"> -->
    <detect>
        <and>
            <rootElementLocalName>r</rootElementLocalName>
            <rootElementAttribute localName="id" value="dict-sme" />
        </and>
    </detect>

    <css name="Editing view" location="dict-sme.css" />

    <include location="../../core/dict.incl" />
    <include location="../../core/dict-batches.incl" />
</configuration>
